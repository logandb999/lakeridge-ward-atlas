# Server-side Neon connection string. Never prefix with VITE_ or commit a real value.
DATABASE_URL=

# Google OAuth web client. Keep the client secret on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random session-signing secret, at least 32 characters. Keep on the server.
AUTH_SECRET=

# Exactly one authorized Google email address (verified by the API).
ATLAS_ALLOWED_EMAIL=

# Fixed canonical app origin; use http://localhost:3001 for local development.
ATLAS_APP_URL=https://lakeridge-ward-atlas.vercel.app

# Browser-visible Google Maps key; restrict by allowed website and API.
VITE_GOOGLE_MAPS_API_KEY=

# Server-only random secret for the daily coordinate cleanup job (at least 32 characters).
CRON_SECRET=

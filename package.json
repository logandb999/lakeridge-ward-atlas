{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vercel dev --listen 3001",
    "dev:vite": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "locations:prepare": "tsx scripts/prepare-household-locations.ts",
    "geocode:households": "tsx scripts/geocode-households.ts",
    "geocode:review": "node --import tsx scripts/inspect-geocoding-review.ts",
    "locations:review-queue": "node --import tsx scripts/prepare-location-review.ts",
    "production:prepare": "node --env-file=.env.production.local --import tsx scripts/prepare-production.ts",
    "locations:flag-followups": "node --env-file=.env.production.local --import tsx scripts/apply-location-followups.ts",
    "households:prepare-import": "tsx scripts/prepare-household-import.ts",
    "households:import-production": "node --env-file=.env.production.local --import tsx scripts/import-production-households.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.3",
    "jose": "^6.2.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^5.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vercel": "^48.1.0"
  }
}

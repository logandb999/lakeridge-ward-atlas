{
  "crons": [
    {
      "path": "/api/geocoding-refresh",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/location-review?cleanup=1",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/geocoding-refresh.ts": {
      "maxDuration": 300
    },
    "api/**/*.ts": {
      "maxDuration": 10
    }
  }
}
